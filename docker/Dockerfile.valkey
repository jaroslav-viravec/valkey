# =============================================================================
# Valkey SERVER image — built from valkey.io SOURCE (Bitnami-free)
#
# Issue #2030 / EPIC #740, "two-image" variant: this builds the `valkey` image
# (primary/replica role). Its sibling docker/Dockerfile.sentinel builds the
# `valkey-sentinel` image. The two share an IDENTICAL build stage — the sentinel
# binary is literally the same program (upstream installs valkey-sentinel as a
# symlink to valkey-server) — they differ only in the default command + port.
#
# (If you prefer ONE image for both roles, use docker/Dockerfile instead.)
#
# The build context is the Valkey source tree (e.g. the git/valkey checkout):
#   docker build -f docker/Dockerfile.valkey --build-arg VALKEY_VERSION=9.1.2 \
#     -t valkey:9.1.2 git/valkey
# =============================================================================

ARG BASE_IMAGE=debian:bookworm-slim
ARG VALKEY_VERSION=9.1.2

# =============================================================================
# Stage 1: build — compile the Valkey source tree from the build context
# =============================================================================
FROM ${BASE_IMAGE} AS build

# Build toolchain. g++ is required for USE_FAST_FLOAT=yes (Valkey 8.1+).
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        dpkg-dev \
        gcc \
        g++ \
        libc6-dev \
        libssl-dev \
        make \
        pkg-config; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/valkey

# Copy the source tree (the build context) and compile it.
COPY . .

# Compile with TLS support and install into a self-contained prefix.
RUN set -eux; \
    make distclean >/dev/null 2>&1 || true; \
    make -j "$(nproc)" \
        BUILD_TLS=yes \
        USE_FAST_FLOAT=yes \
        all; \
    make install PREFIX=/opt/valkey; \
    /opt/valkey/bin/valkey-server --version; \
    strip /opt/valkey/bin/valkey-*

# =============================================================================
# Stage 2: runtime — minimal SERVER image + a non-root user
# =============================================================================
FROM ${BASE_IMAGE} AS runtime
ARG VALKEY_VERSION

LABEL org.opencontainers.image.title="valkey" \
      org.opencontainers.image.description="Valkey server built from valkey.io source (Bitnami-free)" \
      org.opencontainers.image.version="${VALKEY_VERSION}" \
      org.opencontainers.image.source="https://github.com/valkey-io/valkey" \
      org.opencontainers.image.licenses="BSD-3-Clause"

# Runtime deps only: TLS libs + a minimal init (tini) for correct signal/zombie
# handling as PID 1.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        tini \
        tzdata; \
    rm -rf /var/lib/apt/lists/*

# Copy the compiled binaries from the build stage.
COPY --from=build /opt/valkey /opt/valkey
ENV PATH="/opt/valkey/bin:${PATH}"

# Non-root user. UID/GID 1001 + group-0 perms for OpenShift arbitrary-UID.
RUN set -eux; \
    groupadd --gid 1001 valkey; \
    useradd  --uid 1001 --gid 1001 --system --home-dir /data --shell /usr/sbin/nologin valkey; \
    mkdir -p /data /opt/valkey/etc; \
    chown -R 1001:0 /data /opt/valkey/etc; \
    chmod -R g=u /data /opt/valkey/etc

# Entrypoint (generated inline). Normalizes args like the official image:
#   - a leading flag ("-...")  -> prepend valkey-server
#   - a bare ".conf" file      -> prepend valkey-server
RUN set -eux; \
    { \
        echo '#!/bin/sh'; \
        echo 'set -e'; \
        echo 'if [ "${1#-}" != "$1" ]; then set -- valkey-server "$@"; fi'; \
        echo 'case "$1" in'; \
        echo '  *.conf) set -- valkey-server "$@" ;;'; \
        echo 'esac'; \
        echo 'exec "$@"'; \
    } > /usr/local/bin/docker-entrypoint.sh; \
    chmod +x /usr/local/bin/docker-entrypoint.sh

WORKDIR /data
VOLUME ["/data"]

# Server role.
EXPOSE 6379

USER 1001

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["valkey-server"]
